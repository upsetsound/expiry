# Copy to .env.local and fill in. Never commit .env.local.
# Put each value right after "=" with nothing after it: no spaces, quotes or comments on the same line.

# Supabase -> Project Settings -> Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# anon (legacy) or publishable key: safe in the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role (legacy) or secret key: server only, never NEXT_PUBLIC
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret between /api/settle, pg_cron and the settle edge function. Any long random string:
#   openssl rand -hex 32
SETTLE_SECRET=

# Only for the Supabase CLI (pushing migrations, deploying the edge function). Not read by the app.
# The <project-ref> in your project URL:
SUPABASE_PROJECT_REF=
# Project Settings -> Database:
SUPABASE_DB_PASSWORD=

# Share-on-X text after a win: "... on @<handle> <link>". Leave empty to omit.
NEXT_PUBLIC_X_HANDLE=
NEXT_PUBLIC_SITE_URL=

# /admin (stats) is visible only to this Supabase auth user id (Authentication -> Users)
ADMIN_USER_ID=
