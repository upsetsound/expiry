# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=           # anon (legacy) or publishable key — safe in the browser
SUPABASE_SERVICE_ROLE_KEY=               # service_role (legacy) or secret key — server only, never NEXT_PUBLIC

# Shared secret between /api/settle, pg_cron and the `settle` edge function. Any long random string:
#   openssl rand -hex 32
SETTLE_SECRET=

# Only for the Supabase CLI (pushing migrations, deploying the edge function). Not read by the app.
SUPABASE_PROJECT_REF=                    # the <project-ref> in your project URL
SUPABASE_DB_PASSWORD=                    # Project Settings → Database

# Share-on-X text after a win: "… on @<handle> 📈 <site>". Leave empty to omit.
NEXT_PUBLIC_X_HANDLE=
NEXT_PUBLIC_SITE_URL=

# /admin (stats) is visible only to this Supabase auth user id (Authentication -> Users)
ADMIN_USER_ID=
